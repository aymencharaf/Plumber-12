rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isWorkshopMember(workshopId) {
      return isAuthenticated() && (
        getUserData().workshopId == workshopId ||
        exists(/databases/$(database)/documents/workshops/$(workshopId)/members/$(request.auth.uid))
      );
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isUser(userId);
      // User can update profile, BUT CANNOT change role, ownerId, or workshopId directly.
      // Manager can update worker's workshopId when approving join requests.
      // User can update workshopId if an approved join request exists.
      allow update: if (
        isUser(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'ownerId', 'workshopId']))
      ) || (
        isAuthenticated() &&
        isWorkshopMember(request.resource.data.workshopId) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'ownerId']))
      ) || (
        isUser(userId) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'ownerId'])) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['workshopId']) &&
        exists(/databases/$(database)/documents/joinRequests/$(userId + '_' + request.resource.data.workshopId)) &&
        get(/databases/$(database)/documents/joinRequests/$(userId + '_' + request.resource.data.workshopId)).data.status == 'approved'
      );
    }

    // Workshops collection
    match /workshops/{workshopId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isWorkshopMember(workshopId);

      match /members/{memberId} {
        allow read: if isAuthenticated();
        // Allow write if caller is Manager of workshop OR if an approved join request exists for memberId
        allow write: if isAuthenticated() && (
          isWorkshopMember(workshopId) ||
          (
            request.auth.uid == memberId &&
            exists(/databases/$(database)/documents/joinRequests/$(memberId + '_' + workshopId)) &&
            get(/databases/$(database)/documents/joinRequests/$(memberId + '_' + workshopId)).data.status == 'approved'
          )
        );
      }
    }

    // Join Requests collection (Firebase Spark Join Request Flow)
    match /joinRequests/{requestId} {
      allow read: if isAuthenticated() && (
        resource.data.workerUid == request.auth.uid ||
        isWorkshopMember(resource.data.workshopId)
      );
      // Worker creating request: workerUid MUST equal request.auth.uid and status MUST be 'pending'
      allow create: if isAuthenticated() &&
        request.resource.data.workerUid == request.auth.uid &&
        request.resource.data.status == 'pending';

      // Updating request: Manager of workshopId can update status (approve or reject).
      // Worker CANNOT approve their own request! (request.auth.uid != resource.data.workerUid)
      allow update: if isAuthenticated() &&
        isWorkshopMember(resource.data.workshopId) &&
        request.auth.uid != resource.data.workerUid;

      allow delete: if isAuthenticated() && (
        resource.data.workerUid == request.auth.uid ||
        isWorkshopMember(resource.data.workshopId)
      );
    }

    // Projects collection
    match /projects/{projectId} {
      allow read: if isAuthenticated() && (
        isWorkshopMember(resource.data.workshopId) ||
        resource.data.createdBy == request.auth.uid
      );
      allow create: if isAuthenticated() && isWorkshopMember(request.resource.data.workshopId);
      allow update, delete: if isAuthenticated() && isWorkshopMember(resource.data.workshopId);
    }

    // Project items collection
    match /project_items/{itemId} {
      allow read: if isAuthenticated() && (
        isWorkshopMember(resource.data.workshopId) ||
        resource.data.workerId == request.auth.uid
      );
      allow create, update, delete: if isAuthenticated() && isWorkshopMember(request.resource.data.workshopId);
    }

    // Store settings & Audit logs
    match /store_settings/{configId} {
      allow read, write: if isAuthenticated();
    }

    match /audit_logs/{logId} {
      allow read, write: if isAuthenticated();
    }
  }
}
